snippet array array
	$${1:arrayName} = array('${2}' => ${3});${4}
snippet case case
	case '${1:value}':
		${2:// code...}
		break;${3}
snippet class class
	/**
	 * ${1}
	 */
	class ${2:ClassName}
	{
		${3}
		function ${4:__construct}(${5:argument})
		{
			${6:// code...}
		}
	}
snippet def def
	define('${1}'${2});${3}
snippet defd defd
	${1}defined('${2}')${3}
snippet do do
	do {
		${2:// code... }
	} while (${1:/* condition */});"
snippet doc_cp doc_cp
	/**
	 * ${1:undocumented class}
	 *
	 * @package ${2:default}
	 * @author ${3:`g:snips_author`}
	 **/${4}
snippet doc_f doc_f
	/**
	 * $2
	 * @return ${4:void}
	 * @author ${5:`g:snips_author`}
	 **/
	${1:public }function ${2:someFunc}(${3})
	{${6}
	}
snippet doc_h doc_h
	/**
	 * ${1}
	 *
	 * @author ${2:`g:snips_author`}
	 * @version ${3:$Id$}
	 * @copyright ${4:$2}, `strftime('%d %B, %Y')`
	 * @package ${5:default}
	 **/
	/**
	 * Define DocBlock *//
snippet doc_i doc_i
	/**
	 * $1
	 * @package ${2:default}
	 * @author ${3:`g:snips_author`}
	 **/
	interface ${1:someClass}
	{${4}
	} // END interface $1"
snippet ec ec
	echo "${1:string}"${2};
snippet else else
	else {
		${1:// code...}
	}
snippet elseif elseif
	elseif (${1:/* condition */}) {
		${2:// code...}
	}
snippet for for
	for ($${2:i} = 0; $$2 < ${1:count}; $$2${3:++}) {
		${4:// code...}
	}
snippet foreach foreach
	foreach ($${1:variable} as $${2:key}){
		${3:// code...}
	}
snippet foreachk foreachk
	foreach ($${1:variable} as $${2:key} => $${3:value}){
		${4:// code...}
	}
snippet fun fun
	${1:public }function ${2:FunctionName}(${3})
	{
		${4:// code...}
	}
snippet get get
	$_GET['${1}']${2}
snippet globals globals
	$GLOBALS['${1:variable}']${2: = }${3:something}${4:;}${5}
snippet if if
	if (${1:/* condition */}) {
		${2:// code...}
	}
snippet ife ife
	if (${1:/* condition */}) {
		${2:// code...}
	} else {
	}
snippet inc inc
	include '${1:file}';${2}
snippet inc1 inc1
	include_once '${1:file}';${2}
snippet log log
	error_log(var_export(${1}, true));${2}
snippet php php
	<?php
	${1}
	?>
snippet post post
	$_POST['${1}']${2}
snippet req req
	require '${1:file}';${2}
snippet req1 req1
	require_once '${1:file}';${2}
snippet request request
	$_REQUEST['${1}']${2}
snippet session session
	$_SESSION['${1}']${2}
snippet switch switch
	switch ($${1:variable}) {
		case '${2:value}':
			${3:// code...}
			break;
		${5}
		default:
			${4:// code...}
			break;
	}
snippet t t
	$${1:retVal} = (${2:condition}) ? ${3:a} : ${4:b};${5}
snippet var var
	var_export(${1});${2}
snippet wh wh
	while (${1:/* condition */}) {
		${2:// code...}
	}
