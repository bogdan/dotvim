snippet a a
	alert(${1});
snippet adc adc
	addClass('${2:invisible}')${3}
snippet add add
	${1:obj}.add('${2:selector expression}')${3}
snippet ae ae
	addEvent('${1}', function(${2}) {
	  ${3}
	});
snippet after after
	after('${1:'})${2}
snippet ajax ajax
	$.ajax({
		url: ${1:},
		type: "${2:POST}",
		data: ${3:},
		success: function() {
			${4:}
		},
	});
snippet ajaxerror ajaxerror
	.ajaxError(function(${1:request, settings}) {
		${2://stuff to do when an AJAX call returns an error};
	});
	${3}
snippet ajaxget ajaxget
	$.get('${1:/test/ajax-test.xml}', function(xml){
		${2:alert( ("title",xml).text() ) //optional stuff to do after get;}
	});
snippet ajaxgetif ajaxgetif
	$.getIfModified('${1:/test/test.cgi}', function(data){
		${2:alert( "Data loaded: " + data ) //optional stuff to do after get;}
	});
snippet ajaxpost ajaxpost
	$.post('<+/path/to/file.cgi+>',{
	 <+<+param1+>: "<+value1+>", <+param2+>: "<+value2+>"+>},
	 function(){
	    <+//stuff to do after event occurs;+>
	});
snippet ajaxsend ajaxsend
	.ajaxSend(function(${1:request, settings}) {
		${2://stuff to do when an AJAX call returns an error};
	});
	${3}
snippet ajaxsetup ajaxsetup
	$.ajaxSetup({
		url: "${1:mydomain.com/url}",
		type: "${2:POST}",
		dataType: "${3:xml/html/script/json}",
		data: $.param( $("${4:Element or Expression}") ),
	
		complete: function() {
			${5://called when complete}
		},
	
		success: function() {
			${6://called when successful}
		},
	
		error: function() {
			${7://called when there is an error}
		},
	});
snippet ajaxstart ajaxstart
	$.ajaxStart(function() {
		${1://stuff to do when an AJAX call is started and no other AJAX calls are in progress};
	});
	${2}
snippet ajaxstop ajaxstop
	$.ajaxStop(function() {
		${1://stuff to do when an AJAX call is started and no other AJAX calls are in progress};
	});
	${2}
snippet ajaxsuccess ajaxsuccess
	$.ajaxSuccess(function() {
	  ${1://stuff to do when an AJAX call is started and no other AJAX calls are in progress};
	});
	${2}
snippet animate animate
	${1:obj}.animate({${2:param1: value1, param2: value2}}, ${3:speed})${4}
snippet anon anon
	function(${1}) { 
	  ${2}
	};
snippet append append
	${1:obj}.append('${2:Some text <b>and bold!</b>}')${3}
snippet appendTo appendTo
	${1:obj}.appendTo('${2:selector expression}')${3}
snippet as as
	alert("${1}");
snippet attr attr
	${1:obj}.attr('${2:attribute}', '${3:value}')${4}
snippet attrm attrm
	${1:obj}.attr({'${2:attr1}': '${3:value1}', '${4:attr2}': '${5:value2}'})${6}
snippet bef bef
	beforeEach(function(){
		${1}	
	});${2}
snippet bind bind
	${1:obj}.bind('${2:event name}', function(${3:event}) {
		${4:// Act on the event}
	});
snippet blur blur
	${1:obj}.blur(function() {
		${2:// Act on the event}
	});
snippet change change
	${1:obj}.change(function() {
		${2:// Act on the event}
	});
snippet children children
	${1:obj}.children('${2:selector expression}')${3}

snippet click click
	click(function(event) {
		${1:event.preventDefault();}
	});
snippet clone clone
	${1:obj}.clone()${2}
snippet contains contains
	${1:obj}.contains('${2:text to find}')${3}
snippet css css
	${1:obj}.css('${2:attribute}', '${3:value}')${4}
snippet cssm cssm
	${1:obj}.css({${2:attribute1}: '${3:value1}', ${4:attribute2}: '${5:value2}'})${6}
snippet dblclick dblclick
	${1:obj}.dblclick(function() {
		${2:// Act on the event}
	});
snippet desc desc
	describe("${1}", function(){
		${2}	
	});
snippet ea ea
	each(function(${1:item}) {
	  ${2}
	})${3,;}
snippet each each
	each(function(index, ${1:element}) {
		${2:$($1)}
	});
snippet el el
	$('${1}')${2:}
snippet eltrim eltrim
	$.trim('${1:string}')${2}
snippet end end
	${1:obj}.end()${2}
snippet error error
	${1:obj}.error(function() {
		${2:// Act on the event}
	});
snippet f f w
	function(${1}) {
		${2}
	}
snippet fadein fadein
	${1:obj}.fadeIn('${2:slow/400/fast}')${3}
snippet fadeinc fadeinc
	${1:obj}.fadeIn('slow/400/fast', function() {
		${2://Stuff to do *after* the animation takes place};
	});
snippet fadeout fadeout
	${1:obj}.fadeOut('${2:slow/400/fast}')${3}
snippet fadeoutc fadeoutc
	${1:obj}.fadeOut('slow/400/fast', function() {
		${2://Stuff to do *after* the animation takes place};
	});
snippet fadeto fadeto
	${1:obj}.fadeTo('${2:slow/400/fast}', ${3:0.5})${4}
snippet fadetoc fadetoc
	${1:obj}.fadeTo('slow/400/fast', ${2:0.5}, function() {
		${3://Stuff to do *after* the animation takes place};
	});
snippet fb fb
	function() {
		${1}
	}.bind(${2:this})${3}
snippet filter filter
	${1:obj}.filter('${2:selector expression}')${3}
snippet find find
	find('${1:selector expression}')${2}
snippet focus focus
	focus(function() {
		${1:// Act on the event}
	});
snippet for for
	for (var ${1}=0; $1 < ${2}.length; $1++) {
		${3}
	};
snippet get get
	${1:obj}.get(${2:element index})${3}
snippet getjson getjson
	$.getJSON('<+/path/to/file.cgi+>',{
	 <+<+param1+>: "<+value1+>", <+param2+>: "<+value2+>"+>},
	 function(json){
	    <+//stuff to do after event occurs;+>
	});
snippet getscript getscript
	$.getScript('${1:somescript.js}', function(){
		${2://optional stuff to do after getScript;}
	});
snippet height height
	${1:obj}.height(${2:integer})${3}
snippet hide hide
	${1:obj}.hide('${2:slow/400/fast}')${3}
snippet hidec hidec
	${1:obj}.hide('${2:slow/400/fast}', function() {
		${3://Stuff to do *after* the animation takes place}
	});
snippet hover hover
	${1:obj}.hover(function() {
		${2:// Stuff to do when the mouse enters the element;}
	}, function() {
		${3:// Stuff to do when the mouse leaves the element;}
	});${4}
snippet html html
	${1:obj}.html('${2:Some text <b>and bold!</b>}')${3}
snippet if if
	if (${1:true}) { 
	  ${2}
	}${3}
snippet ife ife
	if (${1:true}) {
		${2}
	} else {
	  ${3}
	}
snippet insertAfter insertAfter
	${1:obj}.insertAfter('${2:selector expression}')${3}
snippet insertBefore insertBefore
	${1:obj}.insertBefore('${2:selector expression}')${3}
snippet is is
	${1:obj}.is('${2:selector expression}')${3}
snippet it it
	it("${1}", function(){
	  ${2}
	});
snippet its its
	it("should ${1}", function(){
	  ${2}
	});
snippet j j
	$('${1}')${2}
snippet live live
	$('${1}').live('${2:click}', function(event){
	  ${3:event.preventDefault();}
	});
snippet load load
	${1:obj}.load(function() {
		${2:// Act on the event}
	});
snippet met met
	${1:method_name}: function(${2}){
	  ${3}
	}${4:, }
snippet mmove mmove
	${1:obj}.mousemove(function() {
		${2:// Act on the event}
	});
snippet mout mout
	${1:obj}.mouseout(function() {
		${2:// Act on the event}
	});
snippet mover mover
	${1:obj}.mouseover(function() {
		${2:// Act on the event}
	});
snippet mup mup
	${1:obj}.mouseup(function() {
		${2:// Act on the event}
	});
snippet next next
	${1:obj}.next('${2:selector expression}')${3}
snippet not not
	${1:obj}.not('${2:selector expression}')${3}
snippet one one
	${1:obj}.one('${2:event name}', function(${3:event}) {
		${4:// Act on the event once}
	});
snippet parent parent
	${1:obj}.parent('${2:selector expression}')${3}
snippet parents parents
	${1:obj}.parents('${2:selector expression}')${3}
snippet pe pe
	${1:property}: function(event) {
	  ${2:body}
	}
snippet pf pf
	${1}: function(${2}) {
	  ${3}
	}${4:,}
snippet prepend prepend
	${1:obj}.prepend('${2:Some text <b>and bold!</b>}')${3}
snippet prependto prependto
	${1:obj}.prependTo('${2:selector expression}')${3}
snippet prev prev
	${1:obj}.prev('${2:selector expression}')${3}
snippet proto proto
	${1:class_name}.prototype.${2:method_name} = function(${3:first_argument}) {
		${4:// body}
	};
snippet rdy rdy
	$(document).ready(function() {
		${1:// Stuff to do as soon as the DOM is ready;}
	});
snippet remove remove
	${1:obj}.remove()${2}
snippet removeattr removeattr
	${1:obj}.removeAttr('${2:attribute name}')${3}
snippet reset reset
	${1:obj}.reset(function() {
		${2:// Act on the event}
	});
snippet resize resize
	${1:obj}.resize(function() {
		${2:// Act on the event}
	});
snippet rmc rmc
	removeClass('${1:invisible}');
snippet scroll scroll
	${1:obj}.scroll(function() {
		${2:// Act on the event}
	});
snippet sdown sdown
	${1:obj}.slideDown('${2:slow/400/fast}')${3}
snippet sdownc sdownc
	${1:obj}.slideDown('${2:slow/400/fast}', function() {
		${3://Stuff to do *after* the animation takes place};
	});
snippet sdupc sdupc
	${1:obj}.slideUp('${2:slow/400/fast}', function() {
		${3://Stuff to do *after* the animation takes place};
	});
snippet select select
	${1:obj}.select(function() {
		${2:// Act on the event}
	});
snippet show show
	${1:obj}.show('${2:slow/400/fast}')${3}
snippet showc showc
	${1:obj}.show('${2:slow/400/fast}', function() {
		${3://Stuff to do *after* the animation takes place}
	});
snippet sib sib
	${1:obj}.siblings('${2:selector expression}')${3}
snippet size size
	${1:obj}.size()${2}
snippet stoggle stoggle
	${1:obj}.slideToggle('${2:slow/400/fast}')${3}
snippet submit submit
	submit(function(event) {
		${1:event.preventDefault();}
	});
snippet sup sup
	${1:obj}.slideUp('${2:slow/400/fast}')${3}
snippet text text
	${1:obj}.text(${2:'some text'})${3}
snippet this this
	$(this)${1}
snippet timeout timeout
	setTimeout(function() { ${1} }, ${2:10});
snippet tog tog
	${1:obj}.toggle(function() {
		${2:// Stuff to do every *odd* time the element is clicked;}
	}, function() {
		${3:// Stuff to do every *even* time the element is clicked;}
	});
	${4}
snippet togclass togclass
	${1:obj}.toggleClass('${2:class name}')${3}
snippet togsh togsh
	${1:obj}.toggle('${2:slow/400/fast}')${3}
snippet trel trel
	$(this).rel('${1}')
snippet trig trig
	${1:obj}.trigger('${2:event name}')${3}
snippet unbind unbind
	${1:obj}.unbind('${2:event name}')${3}
snippet val val
	${1:obj}.val('${2:text}')${3}
snippet width width
	${1:obj}.width(${2:integer})${3}
snippet wrap wrap
	${1:obj}.wrap('${2:&lt;div class="extra-wrapper"&gt;&lt;/div&gt;}')${3}
snippet mdown mousedown
	${1:obj}.mousedown(function() {
		${2:// Act on the event}
	});
